# Woverse backend configuration (all optional — the system runs without them)

# --- Local AI (Ollama) ---
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120

# --- Research providers (optional; unconfigured providers report "unconfigured") ---
# Browser research microservice (Playwright + YouTube API)
BROWSER_SERVICE_URL=http://127.0.0.1:8002
# Official YouTube Data API v3 key (used by the Browser Service)
YOUTUBE_API_KEY=
# Google Custom Search JSON API (free tier: 100 queries/day)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CSE_ID=
# Comma-separated RSS feeds for topic research (topic-relevance filtered)
RESEARCH_RSS_FEEDS=https://feeds.bbci.co.uk/news/technology/rss.xml,https://www.theverge.com/rss/index.xml,https://techcrunch.com/feed/

# --- Video production ---
FFMPEG_BINARY=D:\ffmpeg\bin\ffmpeg.exe
FFPROBE_BINARY=D:\ffmpeg\bin\ffprobe.exe

# --- Storage ---
DATABASE_URL=
GENERATED_DIR=
UPLOADS_DIR=
